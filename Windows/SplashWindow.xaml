<Window x:Class="MoliTweak.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Width="480" Height="320" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="RootCard" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="Y" From="10" To="0" Duration="0:0:0.4">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid Margin="12">
        <Border x:Name="RootCard" Background="#0c0d0c" CornerRadius="14" BorderBrush="#1a201b" BorderThickness="1" Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="RootTransform" Y="10"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="6" Opacity="0.75"/>
            </Border.Effect>

            <Grid ClipToBounds="True">
                <!-- Soft ambient light behind logo -->
                <Ellipse Width="320" Height="180" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-40,0,0" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#1222c55e" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <DockPanel Margin="28,26,28,24">
                    <!-- Bottom: Minimal Modern Progress Section -->
                    <StackPanel DockPanel.Dock="Bottom">
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="4.5" Height="4.5" Fill="#22c55e" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtStatus" Text="Donanım kimliği doğrulanıyor..." FontFamily="Segoe UI" FontSize="11" FontWeight="Medium" Foreground="#8e8e93"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtPercent" Text="0%" HorizontalAlignment="Right" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#22c55e"/>
                        </Grid>

                        <!-- Sleek Minimal Progress Bar -->
                        <Border Height="3.5" CornerRadius="2" Background="#161816">
                            <Border x:Name="ProgressFill" Height="3.5" CornerRadius="2" HorizontalAlignment="Left" Width="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#16a34a" Offset="0"/>
                                        <GradientStop Color="#22c55e" Offset="0.8"/>
                                        <GradientStop Color="#4ade80" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#22c55e" BlurRadius="8" ShadowDepth="0" Opacity="0.45"/>
                                </Border.Effect>
                            </Border>
                        </Border>
                    </StackPanel>

                    <!-- Center: Clean Brand Presentation -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <Image Source="/Assets/logo.png" Width="145" HorizontalAlignment="Center" Margin="0,0,0,10" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                            <TextBlock Text="LEMONISTAN" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Foreground="#e5e7eb" VerticalAlignment="Center"/>
                            <Border Background="#14532d" CornerRadius="4" Padding="6,1.5" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v1.0" FontFamily="Segoe UI" FontSize="8.5" FontWeight="Bold" Foreground="#4ade80"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Ultra Low Latency &amp; Performans Motoru" FontFamily="Segoe UI" FontSize="10" Foreground="#52525b" HorizontalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
