<Window x:Class="MoliTweak.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="lemonistan" Width="1280" Height="800" MinWidth="1050" MinHeight="700"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- ═══ SLEEK PROFESSIONAL NAV BUTTON STYLE ═══ -->
        <Style x:Key="ModernNavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#787880"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="10,2,10,2"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnRoot" Background="Transparent" CornerRadius="7" Padding="10,8.5" BorderThickness="0" BorderBrush="Transparent">
                            <Grid>
                                <!-- Minimal Modern Left Accent Capsule -->
                                <Border x:Name="LeftPill" Width="3" Height="0" CornerRadius="1.5"
                                        Background="{DynamicResource AccentBrush}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Opacity="0"/>

                                <!-- Content Presenter with smooth slide transform -->
                                <ContentPresenter x:Name="BtnContent" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <ContentPresenter.RenderTransform>
                                        <TranslateTransform x:Name="BtnSlide" X="0"/>
                                    </ContentPresenter.RenderTransform>
                                </ContentPresenter>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#090a09" CornerRadius="10" BorderBrush="#1a1c1a" BorderThickness="1">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ═══ TITLEBAR (draggable) ═══ -->
            <Border Grid.Row="0" Background="#0d0e0d" CornerRadius="10,10,0,0" BorderBrush="#161816" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Titlebar_MouseLeftButtonDown">
                <DockPanel Margin="16,0">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                        <!-- Close (red) -->
                        <Button Click="Close_Click" Cursor="Hand" Margin="0,0,8,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Ellipse x:Name="Dot" Width="13" Height="13" Fill="#ff5f57"/>
                                        <TextBlock x:Name="Icon" Text="&#x2715;" FontSize="7" FontWeight="Bold" Foreground="Transparent"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Dot" Property="Fill" Value="#e0443e"/>
                                            <Setter TargetName="Icon" Property="Foreground" Value="#4a0002"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- Minimize (yellow) -->
                        <Button Click="Minimize_Click" Cursor="Hand" Margin="0,0,8,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Ellipse x:Name="Dot" Width="13" Height="13" Fill="#febc2e"/>
                                        <TextBlock x:Name="Icon" Text="&#x2500;" FontSize="7" FontWeight="Bold" Foreground="Transparent"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Dot" Property="Fill" Value="#e0a825"/>
                                            <Setter TargetName="Icon" Property="Foreground" Value="#5a3e00"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- Maximize (green) -->
                        <Button Click="Maximize_Click" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Ellipse x:Name="Dot" Width="13" Height="13" Fill="#28c840"/>
                                        <TextBlock x:Name="Icon" Text="&#x25C6;" FontSize="6.5" FontWeight="Bold" Foreground="Transparent"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Dot" Property="Fill" Value="#1aad30"/>
                                            <Setter TargetName="Icon" Property="Foreground" Value="#004a00"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Assets/logo.png" Height="20" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                        <TextBlock Text=" lemonistan" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" Foreground="#f5f5f5" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        <Border Background="#1a1a1a" CornerRadius="4" Padding="5,1.5" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v1.0" FontFamily="Segoe UI" FontSize="8.5" FontWeight="Bold" Foreground="#a3a3a3"/>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ═══ BODY ═══ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ═══ SIDEBAR ═══ -->
                <Border Grid.Column="0" Background="#0b0c0b" BorderBrush="#151715" BorderThickness="0,0,1,0" CornerRadius="0,0,0,10">
                    <DockPanel>

                        <!-- Bottom: Discord Profil & Lisans Kartı (Tıklanabilir) -->
                        <Border x:Name="UserProfileCard" DockPanel.Dock="Bottom" Margin="10,0,10,14" Background="#111211" CornerRadius="8" BorderBrush="#1c201c" BorderThickness="1" Padding="10,8.5" Cursor="Hand" MouseLeftButtonDown="UserProfileCard_MouseLeftButtonDown">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Discord Avatarı & Canlı Yeşil Durum Noktası -->
                                <Grid Grid.Column="0" Margin="0,0,9,0" VerticalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="14" Background="#181a18" BorderBrush="#252d26" BorderThickness="1" ClipToBounds="True">
                                        <Grid>
                                            <TextBlock x:Name="TxtAvatarFallback" Text="D" FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#8e8e93" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image x:Name="ImgDiscordAvatar" Width="28" Height="28" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Grid>
                                    </Border>
                                    <Ellipse Width="7" Height="7" Fill="#22c55e" Stroke="#111211" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-1,-1"/>
                                </Grid>

                                <!-- Discord Kullanıcı Adı & Süre Bilgisi -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtDiscordUsername" Text="Discord..." FontFamily="Segoe UI" FontSize="11.5" FontWeight="SemiBold" Foreground="#f5f5f5" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="Ömür Boyu · Aktif" FontFamily="Segoe UI" FontSize="9" Foreground="#71717a" Margin="0,1,0,0"/>
                                </StackPanel>

                                <!-- Detay oku -->
                                <TextBlock Grid.Column="2" Text="›" FontFamily="Segoe UI" FontSize="15" Foreground="#444444" VerticalAlignment="Center" Margin="2,0,0,2"/>
                            </Grid>
                        </Border>

                        <!-- Nav Items -->
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                            <StackPanel Margin="0,10,0,0">

                                <!-- GENEL -->
                                <TextBlock Text="GENEL" FontFamily="Segoe UI" FontSize="9.5" FontWeight="SemiBold" Foreground="#4b5563" Margin="18,4,0,6"/>

                                <!-- Panel (Lucide LayoutDashboard) -->
                                <Button x:Name="NavDashboard" Tag="dashboard" Click="NavButton_Click" Style="{StaticResource ModernNavButton}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Viewbox Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <Path Data="M3,3 H10 V12 H3 Z M14,3 H21 V8 H14 Z M14,12 H21 V21 H14 Z M3,16 H10 V21 H3 Z"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </Viewbox>
                                        <TextBlock Text="Panel" FontFamily="Segoe UI" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Optimizasyon (Lucide Zap) -->
                                <Button x:Name="NavGamePerf" Tag="gameperf" Click="NavButton_Click" Style="{StaticResource ModernNavButton}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Viewbox Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <Path Data="M13,2 L3,14 H12 L11,22 L21,10 H12 Z"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </Viewbox>
                                        <TextBlock Text="Optimizasyon" FontFamily="Segoe UI" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- GÜVENLİK -->
                                <TextBlock Text="GÜVENLİK" FontFamily="Segoe UI" FontSize="9.5" FontWeight="SemiBold" Foreground="#4b5563" Margin="18,16,0,6"/>

                                <!-- Anticheat (Her Zaman Sabit Yeşil Güvenlik Durumu) -->
                                <Border Margin="10,2,10,2" CornerRadius="7" Padding="10,8.5" Background="Transparent">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <Viewbox Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <Path Data="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" Fill="#22c55e"/>
                                            </Viewbox>
                                            <TextBlock Text="Anticheat" FontFamily="Segoe UI" FontSize="13" FontWeight="Medium" Foreground="#787880" VerticalAlignment="Center"/>
                                            <Border Background="#14532d" CornerRadius="4" Padding="5,1.5" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="4.5" Height="4.5" Fill="#4ade80" Margin="0,0,4,0"/>
                                                    <TextBlock Text="Korumalı" FontFamily="Segoe UI" FontSize="8.5" FontWeight="Bold" Foreground="#4ade80"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- SİSTEM -->
                                <TextBlock Text="SİSTEM" FontFamily="Segoe UI" FontSize="9.5" FontWeight="SemiBold" Foreground="#4b5563" Margin="18,16,0,6"/>

                                <!-- Donanım (Lucide Cpu) -->
                                <Button x:Name="NavRestore" Tag="restore" Click="NavButton_Click" Style="{StaticResource ModernNavButton}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Viewbox Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <Path Data="M4,4 H20 V20 H4 Z M9,1 V4 M15,1 V4 M9,20 V23 M15,20 V23 M1,9 H4 M1,15 H4 M20,9 H23 M20,15 H23 M9,9 H15 V15 H9 Z"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </Viewbox>
                                        <TextBlock Text="Donanım" FontFamily="Segoe UI" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Ayarlar (Lucide Sliders) -->
                                <Button x:Name="NavSettings" Tag="settings" Click="NavButton_Click" Style="{StaticResource ModernNavButton}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Viewbox Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <Path Data="M4,21 V14 M4,10 V3 M12,21 V12 M12,8 V3 M20,21 V16 M20,12 V3 M1,14 H7 M9,8 H15 M17,16 H23"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Viewbox>
                                        <TextBlock Text="Ayarlar" FontFamily="Segoe UI" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- ═══ CONTENT ═══ -->
                <Border Grid.Column="1" Background="#090a09" CornerRadius="0,0,10,0" ClipToBounds="True">
                    <Grid>
                        <!-- Animated background (Varsayılan olarak kapalı, Visibility=Collapsed ile sıfır GPU/CPU yükü) -->
                        <Grid x:Name="GlowGrid" IsHitTestVisible="False" ClipToBounds="True" Visibility="Collapsed" Opacity="0">
                            <Canvas x:Name="BgCanvas" Visibility="Collapsed" Opacity="0"/>
                            
                            <!-- Ambient Efektler -->
                            <Ellipse Width="700" Height="700" Margin="-200,-200,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop x:Name="GlowStop1" Color="#454ade80" Offset="0"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="Glow1Transform"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            <Ellipse Width="900" Height="900" Margin="0,0,-300,-300" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop x:Name="GlowStop2" Color="#4814532d" Offset="0"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="Glow2Transform"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>

                        <!-- Scrollable content with Hardware Render Optimizations -->
                        <ScrollViewer x:Name="ContentScroll"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="False"
                                      PanningMode="VerticalOnly"
                                      RenderOptions.ClearTypeHint="Enabled"
                                      TextOptions.TextFormattingMode="Display"
                                      TextOptions.TextRenderingMode="ClearType">
                            <StackPanel x:Name="ContentPanel" Margin="32,24,32,24"/>
                        </ScrollViewer>

                        <!-- ═══ TELEFON BİLDİRİMİ TARZI SAĞ ÜST MODERN ŞEFFAF BİLDİRİM (TOAST) ═══ -->
                        <Border x:Name="ToastHost" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,16,24,0" Padding="14,10,18,10" CornerRadius="12" BorderThickness="1"
                                Background="#eb131413" BorderBrush="#2e3830" Visibility="Collapsed" IsHitTestVisible="False"
                                Panel.ZIndex="1000" MaxWidth="360">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Opacity="0.6" BlurRadius="24" ShadowDepth="6"/>
                            </Border.Effect>
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="ToastSlide" Y="-40"/>
                            </Border.RenderTransform>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Sol Küçük Rozet -->
                                <Border Grid.Column="0" Width="24" Height="24" CornerRadius="12" Background="#1e241f" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="ToastIcon" Text="✓" FontSize="11" FontWeight="Bold" Foreground="#4ade80" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                </Border>

                                <!-- Sağ Metinler (Sade, Beyaz, Modern) -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="ToastTitle" Text="Bildirim" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold" Foreground="#8e8e93"/>
                                    <TextBlock x:Name="ToastText" FontFamily="Segoe UI" FontSize="12" FontWeight="Medium" Foreground="#f5f5f5" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══ ULTRA SADE & MODERN LİSANS DETAY MODALI ═══ -->
            <Grid x:Name="LicenseModalHost" Grid.RowSpan="2" Background="#ba000000" Visibility="Collapsed" Panel.ZIndex="999" MouseDown="LicenseModalHost_MouseDown">
                <Border x:Name="LicenseModalCard" Width="450" Background="#121312" CornerRadius="16" BorderBrush="#1f2420" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,26" MouseDown="LicenseModalCard_MouseDown">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="8" Opacity="0.8"/>
                    </Border.Effect>
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="LicenseModalScale" ScaleX="0.96" ScaleY="0.96" CenterX="225" CenterY="200"/>
                    </Border.RenderTransform>

                    <StackPanel>
                        <!-- Header: Profil & Kapatma Butonu -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Avatar -->
                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" Background="#181a18" BorderBrush="#283329" BorderThickness="1.5" Margin="0,0,14,0" ClipToBounds="True">
                                <Grid>
                                    <TextBlock x:Name="TxtModalAvatarFallback" Text="D" FontFamily="Segoe UI" FontSize="18" FontWeight="Bold" Foreground="#8e8e93" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image x:Name="ImgModalDiscordAvatar" Width="48" Height="48" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                            </Border>

                            <!-- İsim & Durum -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtModalDiscordUser" Text="lemonistan" FontFamily="Segoe UI" FontSize="16" FontWeight="Bold" Foreground="#f5f5f5"/>
                                    <Ellipse Width="6" Height="6" Fill="#22c55e" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtModalDiscordId" Text="ID: ..." FontFamily="Consolas" FontSize="11" Foreground="#666666" Margin="0,3,0,0"/>
                            </StackPanel>

                            <!-- Kapat (✕) Butonu -->
                            <Button Grid.Column="2" Click="CloseLicenseModal_Click" VerticalAlignment="Top" Cursor="Hand" Background="Transparent" BorderThickness="0" Foreground="#666666">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" CornerRadius="5" Padding="8,4">
                                            <TextBlock Text="✕" FontSize="13" Foreground="{TemplateBinding Foreground}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="#f5f5f5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- İnce Ayırıcı Çizgi -->
                        <Border Height="1" Background="#1a1c1a" Margin="0,0,0,16"/>

                        <!-- Sade Satır Listesi -->
                        <StackPanel>
                            <!-- Paket -->
                            <Grid Margin="0,7">
                                <TextBlock Text="Lisans Paketi" FontFamily="Segoe UI" FontSize="12.5" Foreground="#787880" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtModalPlan" Text="lemonistan PRO (VIP)" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="#f5f5f5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Süre -->
                            <Grid Margin="0,7">
                                <TextBlock Text="Kalan Süre" FontFamily="Segoe UI" FontSize="12.5" Foreground="#787880" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtModalDuration" Text="Sınırsız (Ömür Boyu)" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="#22c55e" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Aktivasyon -->
                            <Grid Margin="0,7">
                                <TextBlock Text="Aktivasyon" FontFamily="Segoe UI" FontSize="12.5" Foreground="#787880" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtModalActivationDate" Text="27.09.2026 22:18" FontFamily="Segoe UI" FontSize="12.5" Foreground="#b0b0b0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Bitiş -->
                            <Grid Margin="0,7">
                                <TextBlock Text="Bitiş Tarihi" FontFamily="Segoe UI" FontSize="12.5" Foreground="#787880" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtModalExpirationDate" Text="Süresiz (Lifetime VIP)" FontFamily="Segoe UI" FontSize="12.5" Foreground="#b0b0b0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Anahtar -->
                            <Grid Margin="0,7">
                                <TextBlock Text="Lisans Key" FontFamily="Segoe UI" FontSize="12.5" Foreground="#787880" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtModalKey" Text="CFXR-••••-••••-2026" FontFamily="Consolas" FontSize="12" Foreground="#cccccc" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Button Click="CopyKey_Click" Cursor="Hand" Background="Transparent" BorderThickness="0" VerticalAlignment="Center">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#181a18" CornerRadius="5" Padding="8,3" BorderBrush="#242c25" BorderThickness="1">
                                                    <TextBlock Text="Kopyala" FontFamily="Segoe UI" FontSize="9.5" FontWeight="SemiBold" Foreground="#9ca3af"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#222822"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- HWID -->
                            <Grid Margin="0,7">
                                <TextBlock Text="HWID" FontFamily="Segoe UI" FontSize="12.5" Foreground="#787880" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtModalHwid" Text="214eb34df40f149e" FontFamily="Consolas" FontSize="11.5" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Button Click="CopyHwid_Click" Cursor="Hand" Background="Transparent" BorderThickness="0" VerticalAlignment="Center">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#181a18" CornerRadius="5" Padding="8,3" BorderBrush="#242c25" BorderThickness="1">
                                                    <TextBlock Text="Kopyala" FontFamily="Segoe UI" FontSize="9.5" FontWeight="SemiBold" Foreground="#9ca3af"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#222822"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
