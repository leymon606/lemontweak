<Window x:Class="MoliTweak.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Width="480" Height="460" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="LoginContent" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6" BeginTime="0:0:0.1">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="LoginSlide" Storyboard.TargetProperty="Y" From="16" To="0" Duration="0:0:0.6" BeginTime="0:0:0.1">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border Background="#0a0a0a" CornerRadius="12" BorderBrush="#1a1a1a" BorderThickness="1">
        <Grid ClipToBounds="True">
            <!-- Animated Ambient Background -->
            <Ellipse Width="500" Height="500" Margin="-200,-150,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#2216a34a" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="LoginGlowTransform"/>
                </Ellipse.RenderTransform>
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="0.8" Duration="0:0:4" AutoReverse="True" RepeatBehavior="Forever">
                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="LoginGlowTransform" Storyboard.TargetProperty="X" From="0" To="120" Duration="0:0:8" AutoReverse="True" RepeatBehavior="Forever">
                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="LoginGlowTransform" Storyboard.TargetProperty="Y" From="0" To="60" Duration="0:0:10" AutoReverse="True" RepeatBehavior="Forever">
                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>

            <Button Content="&#x2715;" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,14,0" Cursor="Hand" Click="Close_Click" FontSize="11" Foreground="#525252">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="8,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1a1a1a"/>
                                <Setter Property="Foreground" Value="#a3a3a3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <StackPanel x:Name="LoginContent" VerticalAlignment="Center" HorizontalAlignment="Center" Width="340" Opacity="0">
                <StackPanel.RenderTransform><TranslateTransform x:Name="LoginSlide" Y="16"/></StackPanel.RenderTransform>

                <Image Source="/Assets/logo.png" Width="140" HorizontalAlignment="Center" Margin="0,0,0,6" RenderOptions.BitmapScalingMode="HighQuality"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
                    <TextBlock Text="lemonistan" FontFamily="Segoe UI" FontSize="11" FontWeight="Light" Foreground="#4ade80" VerticalAlignment="Center"/>
                    <Border Background="#14532d" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="V1.0" FontFamily="Segoe UI" FontSize="8" FontWeight="Bold" Foreground="#4ade80"/>
                    </Border>
                </StackPanel>

                <Border Background="#111111" BorderBrush="#1a1a1a" BorderThickness="1" CornerRadius="10" Padding="24,20">
                    <StackPanel>
                        <TextBlock Text="Kontrol paneline eri&#x15F;" FontFamily="Segoe UI" FontSize="16" FontWeight="SemiBold" Foreground="#f5f5f5" Margin="0,0,0,4"/>
                        <TextBlock Text="Lisans anahtar&#x131;n bu cihaz&#x131;n donan&#x131;m kimli&#x11F;ine ba&#x11F;lan&#x131;r." FontFamily="Segoe UI" FontSize="11" Foreground="#525252" Margin="0,0,0,18"/>

                        <TextBlock Text="L&#x130;SANS ANAHTARI" FontFamily="Segoe UI" FontSize="9" FontWeight="SemiBold" Foreground="#3f3f3f" Margin="0,0,0,6"/>
                        <Border Background="#0c0c0c" BorderBrush="#1e1e1e" BorderThickness="1" CornerRadius="6" Padding="12,10">
                            <TextBox x:Name="TxtKey" FontFamily="Segoe UI" FontSize="13" Foreground="White" Background="Transparent" BorderThickness="0" CaretBrush="#22c55e"/>
                        </Border>

                        <TextBlock x:Name="TxtError" Text="" FontFamily="Segoe UI" FontSize="10" Foreground="#ef4444" Margin="0,8,0,0" Visibility="Collapsed"/>

                        <Button Margin="0,16,0,0" Height="42" Click="Login_Click" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" CornerRadius="8" Padding="0,10" Background="#16a34a">
                                        <TextBlock Text="Giri&#x15F; yap" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#22c55e"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>

                <Grid Margin="0,14,0,0">
                    <TextBlock Text="DONANIM K&#x130;ML&#x130;&#x11E;&#x130;" FontFamily="Segoe UI" FontSize="9" FontWeight="SemiBold" Foreground="#2a2a2a" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="TxtHwid" FontFamily="Consolas" FontSize="10" Foreground="#2a2a2a" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
